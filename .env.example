# 🔐 ENVIRONMENT VARIABLES

# 🌍 SERVER CONFIG
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 🤖 AI SERVICE CONFIG
AI_SERVICE_NAME=ai-service
AI_VERSION=v1

# 🎤 STT SERVICE (Speech-to-Text)
STT_PROVIDER=whisper          # whisper | external
STT_SERVICE_URL=http://localhost:8001
STT_TIMEOUT=30

# 🧠 LLM SERVICE (GPT / etc)
LLM_PROVIDER=openai           # openai | local
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# 🔊 AUDIO PROCESSING
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FORMAT=wav

# 📡 REALTIME / WEBSOCKET
WS_URL=ws://localhost:8000/ws
WS_TIMEOUT=30

# 🗄 DATABASE
DB_TYPE=sqlite                # sqlite | postgres
DB_PATH=./data/app.db

# PostgreSQL (optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 📦 STORAGE
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# 🚨 ALERT / EVENT SYSTEM
ALERT_THRESHOLD=0.7
EVENT_WINDOW_SECONDS=5

# 🔧 DEVELOPMENT
DEBUG=true
RELOAD=true
